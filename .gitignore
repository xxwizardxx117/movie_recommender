# Local working notes — never pushed to the remote
docs/

# Raw dataset & TMDB exports (downloaded locally, not versioned)
Data/

# Uncompressed pickle artifacts (the .gz versions are committed instead)
similarity.pkl
movie_list.pkl

# Virtual environments (uv creates .venv/)
venv
venv/
.venv/
env/

# NOTE:
# uv.lock is deliberately IGNORED. Streamlit Cloud ranks it ABOVE requirements.txt,
# so committing it switches the installer to `uv sync` from pyproject.toml
# which installs the dev group (jupyter, scikit-learn, nltk) into production.
# requirements.txt is generated from the lock with --no-dev,
# so the pins are already identical; the lockfile adds nothing but risk.
uv.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Secrets
.env
.streamlit/secrets.toml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
